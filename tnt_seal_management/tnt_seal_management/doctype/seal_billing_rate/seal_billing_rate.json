   "fieldname": "billing_rule_name",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Billing Rule Name",
   "reqd": 1
  },
  {
   "default": "Subscription",
   "description": "Leasing rates are private, per-customer contracts and are no longer created here — they're set from Current Customer List → Set Billing, which manages this rule automatically.",
   "fieldname": "billing_type",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Billing Type",
   "options": "Subscription"
  },
  {
   "default": "Local",
   "description": "Which kind of seal journey this rate applies to. Rates differ by journey type: Local has its own set, while Import and Export share one. A customer's two rate sets share a single Billing Rule Name and are told apart by this field — Local is the customer's primary rule (the one their billing assignment points at), the Import/Export rule is a sibling carrying only its own rates. Each is approved separately. Set from Current Customer List → Set Billing.",
   "fieldname": "journey_type",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Journey Type",
   "options": "Local\nImport/Export"
  },
  {
   "depends_on": "eval:doc.billing_type=='Subscription'",
   "description": "Flat Rate: one fixed recurring charge per cycle, day-tiering fields hidden. Non-Flat Rate: day-tiered like a per-journey rate (First Period Days/Amount + Extra Day Rate). Set from Current Customer List → Set Billing.",
   "fieldname": "rate_type",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Rate Type",
   "options": "\nFlat Rate\nNon-Flat Rate"
  },
  {
   "default": "Simple",
   "depends_on": "eval:doc.rate_type=='Non-Flat Rate'",
   "description": "Simple: each journey is billed on its own day count. Compound: total days across every journey billed together are summed, divided by First Period Days, rounded up to a whole period, and multiplied by First Period Amount — computed once at Sales Order generation, not per journey. Set from Current Customer List → Set Billing.",
   "fieldname": "computation_method",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Computation",
   "options": "Simple\nCompound"
  },
